<UserControl x:Class="Eigen.Controls.PreviewInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Eigen.Models"
             Background="{DynamicResource BgSidebarBrush}">
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Preview Header -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,8,0">
                <Grid>
                    <TextBlock Text="Inspector"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right"
                            Content="&#xE711;"
                            FontSize="11"
                            ToolTip="Close Inspector (Alt+P)"
                            Command="{Binding TogglePreviewPaneCommand}" />
                </Grid>
            </Border>

            <!-- Empty State -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="24"
                        Visibility="{Binding CurrentPreview, Converter={StaticResource InvNullToVis}}">
                <TextBlock FontFamily="{StaticResource IconFont}"
                           Text="&#xE8A0;"
                           FontSize="32"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />
                <TextBlock Text="No item selected"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Select a file or folder to view previews and properties."
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Preview Body -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding CurrentPreview, Converter={StaticResource NullToVis}}">
                <StackPanel Margin="14" DataContext="{Binding CurrentPreview}">
                    <!-- Item Title & Type -->
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,3,0,12" />

                    <!-- Quick Action Row -->
                    <WrapPanel Margin="0,0,0,14">
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Height="28"
                                Padding="10,0"
                                Margin="0,0,6,6"
                                Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Copy Path" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Height="28"
                                Padding="10,0"
                                Margin="0,0,6,6"
                                Command="{Binding DataContext.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Properties" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Interactive Preview Region (supports all file types) -->
                    <StackPanel x:Name="PreviewHoverTrigger"
                                Background="Transparent"
                                MouseEnter="OnPreviewSurfaceMouseEnter">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanZoom}" Value="False">
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Badge & Center-Zoom Hint Strip -->
                        <Grid Margin="0,0,0,8">
                            <Border HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="4"
                                    Padding="7,2"
                                    Visibility="{Binding PreviewBadge, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding PreviewBadge}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Opacity="0.82"
                                        Visibility="{Binding CanZoom, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontFamily="{StaticResource IconFont}"
                                           Text="&#xE8A3;"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="Hover to pop out"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Live Video Player Card -->
                        <Border x:Name="PreviewVideoCard"
                                Background="{DynamicResource BgContentBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Margin="0,0,0,12"
                                Visibility="{Binding Kind, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:PreviewKind.Video}}">
                            <StackPanel>
                                <Border Background="#111111"
                                        CornerRadius="6"
                                        ClipToBounds="True"
                                        MinHeight="140"
                                        MaxHeight="240"
                                        MouseLeftButtonUp="OnVideoSurfaceClick"
                                        ToolTip="Click to play / pause">
                                    <Grid>
                                        <MediaElement x:Name="PreviewVideoPlayer"
                                                      LoadedBehavior="Manual"
                                                      UnloadedBehavior="Close"
                                                      Stretch="Uniform"
                                                      MaxHeight="240"
                                                      ScrubbingEnabled="True"
                                                      MediaOpened="OnVideoMediaOpened"
                                                      MediaEnded="OnVideoMediaEnded"
                                                      MediaFailed="OnVideoMediaFailed" />
                                        <Image x:Name="PreviewVideoFallbackImage"
                                               Source="{Binding PreviewImage}"
                                               Stretch="Uniform"
                                               MaxHeight="240"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Slider x:Name="VideoSeekSlider"
                                        Margin="0,8,0,4"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0"
                                        IsMoveToPointEnabled="True"
                                        PreviewMouseLeftButtonDown="OnVideoSeekStart"
                                        PreviewMouseLeftButtonUp="OnVideoSeekEnd"
                                        ValueChanged="OnVideoSeekValueChanged" />
                                <Grid Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button x:Name="VideoPlayPauseButton"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="28" Height="26"
                                                FontSize="11"
                                                Content="&#xE769;"
                                                ToolTip="Pause / Play (Space or K)"
                                                Click="OnVideoPlayPauseClick" />
                                        <Button x:Name="VideoMuteButton"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="28" Height="26"
                                                Margin="4,0,0,0"
                                                FontSize="11"
                                                Content="&#xE74F;"
                                                ToolTip="Unmute / Mute (M)"
                                                Click="OnVideoMuteClick" />
                                        <Slider x:Name="VideoVolumeSlider"
                                                Width="64"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="0.85"
                                                IsMoveToPointEnabled="True"
                                                ToolTip="Volume"
                                                ValueChanged="OnVideoVolumeChanged" />
                                    </StackPanel>
                                    <TextBlock x:Name="VideoStatusText"
                                               FontSize="11"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Text="0:00" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Visual Thumbnail / Image / Shell Icon Card -->
                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Margin="0,0,0,12"
                                Background="{DynamicResource BgContentBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="{Binding PreviewImage, Converter={StaticResource NullToVis}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="MaxHeight" Value="48" />
                                            <Setter Property="MaxWidth" Value="48" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVisualThumbnail}" Value="True">
                                                    <Setter Property="MaxHeight" Value="240" />
                                                    <Setter Property="MaxWidth" Value="480" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding ImageDimensions}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding ImageDimensions, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Text / Code / Archive / Hex / Folder Sample Preview -->
                        <Border Background="{DynamicResource BgInputBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,14"
                                Visibility="{Binding TextContent, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding TextStats}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,8"
                                           Visibility="{Binding TextStats, Converter={StaticResource NullToVis}}" />
                                <TextBox Text="{Binding TextContent, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         FontFamily="{StaticResource MonoFont}"
                                         FontSize="11.5"
                                         TextWrapping="Wrap"
                                         MaxHeight="250"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled" />
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Height="30"
                                        Padding="12,0"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding OpenPromptLabel, Converter={StaticResource NullToVis}}"
                                        Command="{Binding DataContext.OpenPreviewFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding OpenPromptLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Folder Stats -->
                    <Border Background="{DynamicResource BgContentBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,14"
                            Visibility="{Binding Kind, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:PreviewKind.Folder}}">
                        <StackPanel>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8">
                                <Run Text="Direct contents: " Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{Binding FolderSubdirCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" folders, " />
                                <Run Text="{Binding FolderFileCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" files" />
                            </TextBlock>
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Height="28"
                                    Command="{Binding DataContext.CalculateFolderSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Calculate Total Size" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding DataContext.CalculatedFolderSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding DataContext.CalculatedFolderSize, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Details Metadata Card -->
                    <Border Background="{DynamicResource BgContentBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Size" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,7"
                                       Visibility="{Binding ExactSizeText, Converter={StaticResource NullToVis}}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ExactSizeText}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,7"
                                       Visibility="{Binding ExactSizeText, Converter={StaticResource NullToVis}}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Modified" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,7" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModifiedText}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,7" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Created" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,7" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreatedText}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,7" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Accessed" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,7" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccessedText}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,7" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Attributes" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,7" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AttributesText}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,7" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Location" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FullPath}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
