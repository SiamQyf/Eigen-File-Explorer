<UserControl x:Class="Eigen.Controls.CustomizeDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Eigen.Models"
             xmlns:vm="clr-namespace:Eigen.ViewModels"
             Background="{DynamicResource BgSidebarBrush}">
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Drawer Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,8,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   Text="&#xE771;"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="Customize"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Height="24"
                                Padding="8,0"
                                FontSize="11"
                                Content="Reset"
                                ToolTip="Reset all vertical gaps, icon/font sizing, and typography to defaults"
                                Margin="0,0,4,0"
                                Command="{Binding ResetLayoutCustomizationCommand}" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Width="26" Height="26"
                                Content="&#xE711;"
                                FontSize="10"
                                ToolTip="Close Customize"
                                Command="{Binding ToggleCustomizePaneCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Unified Smooth Scroll Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Layout, Typography & Icon Pack -->
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="VERTICAL GAPS"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,8" />

                            <!-- Details Rows Gap -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Details Rows" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding DetailsVerticalGap, StringFormat={}{0:0}}" /><Run Text=" px" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinDetailsVerticalGap}"
                                    Maximum="{x:Static vm:MainViewModel.MaxDetailsVerticalGap}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding DetailsVerticalGap, Mode=TwoWay}"
                                    ToolTip="Vertical spacing and row padding in Details list view (0–40 px)"
                                    Margin="0,0,0,7" />

                            <!-- Tiles Grid Gap -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Tiles Grid" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding TilesVerticalGap, StringFormat={}{0:0}}" /><Run Text=" px" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinTilesVerticalGap}"
                                    Maximum="{x:Static vm:MainViewModel.MaxTilesVerticalGap}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding TilesVerticalGap, Mode=TwoWay}"
                                    ToolTip="Vertical spacing between card rows in Tiles view (0–48 px)"
                                    Margin="0,0,0,7" />

                            <!-- Compact List Gap -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Compact List" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding CompactVerticalGap, StringFormat={}{0:0}}" /><Run Text=" px" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinCompactVerticalGap}"
                                    Maximum="{x:Static vm:MainViewModel.MaxCompactVerticalGap}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding CompactVerticalGap, Mode=TwoWay}"
                                    ToolTip="Vertical spacing between items in Compact list view (0–40 px)"
                                    Margin="0,0,0,7" />

                            <!-- Sidebar Nav Gap -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Sidebar Nav" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding SidebarVerticalGap, StringFormat={}{0:0}}" /><Run Text=" px" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinSidebarVerticalGap}"
                                    Maximum="{x:Static vm:MainViewModel.MaxSidebarVerticalGap}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding SidebarVerticalGap, Mode=TwoWay}"
                                    ToolTip="Vertical spacing across Quick Access and This PC tree items (0–32 px)"
                                    Margin="0,0,0,7" />

                            <!-- Home Cards Gap -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Home Cards" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding HomeVerticalGap, StringFormat={}{0:0}}" /><Run Text=" px" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinHomeVerticalGap}"
                                    Maximum="{x:Static vm:MainViewModel.MaxHomeVerticalGap}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding HomeVerticalGap, Mode=TwoWay}"
                                    ToolTip="Vertical spacing between Home dashboard sections and cards (0–48 px)"
                                    Margin="0,0,0,10" />

                            <TextBlock Text="ICON &amp; FONT SIZING"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,8" />

                            <!-- Icon Size -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Icon Size" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding ItemIconSize, StringFormat={}{0:0}}" /><Run Text=" px" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinIconSize}"
                                    Maximum="{x:Static vm:MainViewModel.MaxIconSize}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ItemIconSize, Mode=TwoWay}"
                                    Margin="0,0,0,10" />

                            <!-- Font Size -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Font Size" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding ItemFontSize, StringFormat={}{0:0.#}}" /><Run Text=" px" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinFontSize}"
                                    Maximum="{x:Static vm:MainViewModel.MaxFontSize}"
                                    TickFrequency="0.5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ItemFontSize, Mode=TwoWay}"
                                    Margin="0,0,0,7" />

                            <!-- Icon Left Gap -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Icon Left Space" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding IconLeftGap, StringFormat={}{0:0}}" /><Run Text=" px" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinIconLeftGap}"
                                    Maximum="{x:Static vm:MainViewModel.MaxIconLeftGap}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding IconLeftGap, Mode=TwoWay}"
                                    ToolTip="Space to the left of icons in Details, Compact, and Sidebar (0–48 px)"
                                    Margin="0,0,0,7" />

                            <!-- Icon-Text Horizontal Gap -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Icon–Text Gap (H)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding IconTextHorizontalGap, StringFormat={}{0:0}}" /><Run Text=" px" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinIconTextHorizontalGap}"
                                    Maximum="{x:Static vm:MainViewModel.MaxIconTextHorizontalGap}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding IconTextHorizontalGap, Mode=TwoWay}"
                                    ToolTip="Horizontal gap between icon and name in Details, Compact, and Sidebar (0–48 px)"
                                    Margin="0,0,0,7" />

                            <!-- Icon-Text Vertical Gap -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Icon–Text Gap (V)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding IconTextVerticalGap, StringFormat={}{0:0}}" /><Run Text=" px" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinIconTextVerticalGap}"
                                    Maximum="{x:Static vm:MainViewModel.MaxIconTextVerticalGap}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding IconTextVerticalGap, Mode=TwoWay}"
                                    ToolTip="Vertical gap between icon and name in Tiles view (0–36 px)"
                                    Margin="0,0,0,10" />

                            <!-- Typography Section -->
                            <TextBlock Text="TYPOGRAPHY"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,8" />

                            <!-- Font Family -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Font Family" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="{Binding InstalledFontCount, Mode=OneWay}" /><Run Text=" installed" />
                                </TextBlock>
                            </Grid>
                            <ComboBox ItemsSource="{Binding AvailableFonts}"
                                      SelectedItem="{Binding SelectedFontOption, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      IsTextSearchEnabled="True"
                                      Margin="0,0,0,10" />

                            <!-- Font Weight (Constrained 300 - 600) -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Font Weight" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding FontWeightLabel}"
                                           HorizontalAlignment="Right"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinFontWeightValue}"
                                    Maximum="{x:Static vm:MainViewModel.MaxFontWeightValue}"
                                    TickFrequency="100"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding FontWeightValue, Mode=TwoWay}"
                                    Margin="0,0,0,10" />

                            <!-- Letter Spacing (Constrained -0.5 to +3.0 px) -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Letter Spacing" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding LetterSpacingLabel}"
                                           HorizontalAlignment="Right"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                            <Slider Minimum="{x:Static vm:MainViewModel.MinLetterSpacing}"
                                    Maximum="{x:Static vm:MainViewModel.MaxLetterSpacing}"
                                    TickFrequency="0.25"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding LetterSpacing, Mode=TwoWay}"
                                    Margin="0,0,0,10" />

                            <!-- Icon Pack Override -->
                            <TextBlock Text="ICON PACK"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,6" />
                            <ItemsControl ItemsSource="{Binding AvailableIconPacks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Height="22"
                                                Margin="0,0,5,5"
                                                Padding="8,0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.SelectIconPackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource BgContentBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                                                    </Trigger>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource ValuesEqualMulti}">
                                                                                <Binding />
                                                                                <Binding Path="DataContext.IconPackOverride" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSelectionBrush}" />
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BgSelectionHoverBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding}" FontSize="10.5" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Skins Picker (2-Column Side-by-Side Grid) -->
                    <StackPanel Margin="14,12,12,14">
                        <Grid Margin="0,0,0,8">
                            <TextBlock VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="SKINS (" /><Run Text="{Binding AllSkins.Count, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Height="24"
                                    Padding="8,0"
                                    ToolTip="Try a random skin"
                                    Command="{Binding RandomSkinCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B1;" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="Surprise Me" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Search Skins -->
                        <Grid Margin="0,0,0,8">
                            <TextBox Style="{StaticResource EigenTextBoxStyle}"
                                     Height="28"
                                     Padding="8,2"
                                     FontSize="12"
                                     Text="{Binding SkinSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Filter skins by name or mood..."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SkinSearchQuery, Converter={StaticResource InvNullToVis}}" />
                        </Grid>

                        <!-- Category Filter Pills -->
                        <ItemsControl ItemsSource="{Binding SkinCategories}" Margin="0,0,0,9">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="22"
                                            Margin="0,0,5,5"
                                            Padding="8,0"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.SelectSkinCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource BgContentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="11"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                                                </Trigger>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource ValuesEqualMulti}">
                                                                            <Binding />
                                                                            <Binding Path="DataContext.SelectedSkinCategory" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSelectionBrush}" />
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BgSelectionHoverBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding}" FontSize="10.5" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Side-by-Side 2-Column Skin Cards Grid -->
                        <ItemsControl x:Name="SkinsItemsControl" ItemsSource="{Binding FilteredSkins}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" Margin="-3,0,-3,0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:EigenSkin}">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Margin="3,0,3,7"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.SelectSkinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CardBorder"
                                                        Background="{DynamicResource BgContentBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="{DynamicResource SurfaceBorderThickness}"
                                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                                        Padding="7">
                                                    <StackPanel>
                                                        <!-- Mini Live Palette Swatch -->
                                                        <Border Height="34"
                                                                CornerRadius="5"
                                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                BorderThickness="1"
                                                                ClipToBounds="True"
                                                                Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{Binding PreviewSidebarBrush}">
                                                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                                        <Border Height="3" CornerRadius="1.5" Background="{Binding PreviewAccentBrush}" Margin="0,0,0,3" />
                                                                        <Border Height="2" CornerRadius="1" Background="{Binding PreviewTextBrush}" Opacity="0.45" Margin="0,0,3,3" />
                                                                        <Border Height="2" CornerRadius="1" Background="{Binding PreviewTextBrush}" Opacity="0.28" Margin="0,0,5,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Grid.Column="1" Background="{Binding PreviewBgBrush}" Padding="6,5">
                                                                    <Grid>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <Border Height="3" Width="40" HorizontalAlignment="Left" CornerRadius="1.5" Background="{Binding PreviewTextBrush}" Opacity="0.78" Margin="0,0,0,4" />
                                                                            <Border Height="2.5" Width="28" HorizontalAlignment="Left" CornerRadius="1" Background="{Binding PreviewTextBrush}" Opacity="0.35" />
                                                                        </StackPanel>
                                                                        <Ellipse Width="10" Height="10"
                                                                                 HorizontalAlignment="Right"
                                                                                 VerticalAlignment="Bottom"
                                                                                 Fill="{Binding PreviewAccentBrush}" />
                                                                        <Border x:Name="ActiveCheckBadge"
                                                                                Width="14" Height="14"
                                                                                CornerRadius="7"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Top"
                                                                                Background="{DynamicResource AccentBrush}"
                                                                                Visibility="Collapsed">
                                                                            <TextBlock FontFamily="{StaticResource IconFont}"
                                                                                       Text="&#xE73E;"
                                                                                       FontSize="8"
                                                                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Mood}"
                                                                   FontSize="9.8"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border x:Name="TagPill"
                                                                HorizontalAlignment="Left"
                                                                CornerRadius="4"
                                                                Padding="5,1.5"
                                                                Margin="0,4,0,0"
                                                                Background="{DynamicResource BgSidebarBrush}">
                                                            <TextBlock x:Name="TagText"
                                                                       Text="{Binding AestheticTag}"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BgSelectionHoverBrush}" />
                                                        <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource ValuesEqualMulti}">
                                                                <Binding Path="Id" />
                                                                <Binding Path="DataContext.ActiveSkin.Id" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5" />
                                                        <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource BgSelectionBrush}" />
                                                        <Setter TargetName="TagPill" Property="Background" Value="{DynamicResource BgSelectionHoverBrush}" />
                                                        <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Setter TargetName="ActiveCheckBadge" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
