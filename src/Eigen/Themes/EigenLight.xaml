<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">12</CornerRadius>
    <Thickness x:Key="SurfaceBorderThickness">1</Thickness>

    <SolidColorBrush x:Key="BgWindowBrush" Color="#E6E9EF" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#DCE0E8" />
    <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="#DCE0E8" />
    <SolidColorBrush x:Key="HomeHeroBrush" Color="#D4DDF5" />
    <SolidColorBrush x:Key="BgContentBrush" Color="#EFF1F5" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgInputBrush" Color="#EFF2F5" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#D2D6E0" />
    <SolidColorBrush x:Key="BgPressedBrush" Color="#C8CCD8" />
    <SolidColorBrush x:Key="BgSelectionBrush" Color="#CCD9F5" />
    <SolidColorBrush x:Key="BgSelectionHoverBrush" Color="#BBCEF5" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#C8CCD6" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B6BBC9" />

    <SolidColorBrush x:Key="AccentBrush" Color="#1E66F5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A58D3" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#D4DDF5" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#363A4F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5F77" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#828598" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="DangerBrush" Color="#C43E37" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#CCCFD9" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B8BCC9" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A0A5B7" />
</ResourceDictionary>
