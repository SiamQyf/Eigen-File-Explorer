<Window x:Class="Eigen.Views.CreateArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eigen Archiver — Add to Archive"
        Width="480"
        Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="34" Height="34"
                    CornerRadius="8"
                    Background="{DynamicResource AccentSoftBrush}"
                    Margin="0,0,10,0">
                <TextBlock FontFamily="{StaticResource IconFont}"
                           Text="&#xF012;"
                           FontSize="16"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Eigen Archiver"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="SourceSummaryText"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Archive name" VerticalAlignment="Center" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
            <TextBox x:Name="ArchiveNameBox" Grid.Row="0" Grid.Column="1" Height="32" Margin="0,0,0,12"
                     Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource BgInputBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderStrongBrush}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Archive format" VerticalAlignment="Center" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
            <ComboBox x:Name="FormatCombo" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,0,0,12"
                      SelectionChanged="OnFormatSelectionChanged">
                <ComboBoxItem Content="ZIP (.zip) — Universal" Tag="Zip" IsSelected="True" />
                <ComboBoxItem Content="TAR.GZ (.tar.gz) — Compressed TAR" Tag="TarGz" />
                <ComboBoxItem Content="TAR (.tar) — Uncompressed TAR" Tag="Tar" />
                <ComboBoxItem Content="TAR.BZ2 (.tar.bz2) — BZip2 TAR" Tag="TarBz2" />
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Compression" VerticalAlignment="Center" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
            <ComboBox x:Name="CompressionCombo" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,0,0,12">
                <ComboBoxItem Content="Store (No compression, fastest)" Tag="Store" />
                <ComboBoxItem Content="Fast" Tag="Fast" />
                <ComboBoxItem Content="Normal (Recommended)" Tag="Normal" IsSelected="True" />
                <ComboBoxItem Content="Maximum (Smallest size)" Tag="Maximum" />
            </ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Destination" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationBox" Grid.Column="0" Height="32" Padding="10,0" VerticalContentAlignment="Center"
                         Background="{DynamicResource BgInputBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderStrongBrush}" />
                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Height="32" Margin="8,0,0,0"
                        Padding="12,0" Content="Browse..." Click="OnBrowseClick" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource ActionButtonStyle}" Height="32" Padding="16,0" Margin="0,0,8,0"
                    Content="Cancel" IsCancel="True" />
            <Button Style="{StaticResource AccentButtonStyle}" Height="32" Padding="18,0"
                    Content="Create Archive" IsDefault="True" Click="OnCreateClick" />
        </StackPanel>
    </Grid>
</Window>
