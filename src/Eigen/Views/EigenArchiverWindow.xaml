<Window x:Class="Eigen.Views.EigenArchiverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eigen Archiver"
        Width="880"
        Height="580"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButtonStyle}" Height="32" Padding="12,0" Margin="0,0,8,0"
                            Click="OnExtractToClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Extract To..." FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButtonStyle}" Height="32" Padding="12,0" Margin="0,0,8,0"
                            Click="OnExtractHereClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Extract Here" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddFilesButton" Style="{StaticResource ActionButtonStyle}" Height="32" Padding="12,0" Margin="0,0,8,0"
                            Click="OnAddFilesClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Add Files..." FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButtonStyle}" Height="32" Padding="12,0"
                            Click="OnTestArchiveClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Test" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="ArchiveTitleBadge"
                           DockPanel.Dock="Right"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Navigation & Filter Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <Button x:Name="UpButton" Grid.Column="0" Style="{StaticResource IconButtonStyle}"
                        Width="30" Height="28" Margin="0,0,8,0"
                        Content="&#xE74A;" FontSize="12"
                        ToolTip="Parent folder inside archive"
                        Click="OnUpClick" />

                <Border Grid.Column="1"
                        Background="{DynamicResource BgInputBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Height="28"
                        Padding="10,0"
                        Margin="0,0,10,0">
                    <TextBlock x:Name="InternalPathText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <TextBox x:Name="FilterBox"
                         Grid.Column="2"
                         Height="28"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource BgInputBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         ToolTip="Filter archive entries"
                         TextChanged="OnFilterChanged" />
            </Grid>
        </Border>

        <!-- Entries ListView -->
        <ListView x:Name="EntriesListView"
                  Grid.Row="2"
                  Background="{DynamicResource BgContentBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderThickness="0"
                  SelectionMode="Extended"
                  MouseDoubleClick="OnEntryDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="360">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,3">
                                    <TextBlock FontFamily="{StaticResource IconFont}"
                                               FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE8A5;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Text" Value="&#xE8B7;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Size" Width="105" DisplayMemberBinding="{Binding SizeDisplay}" />
                    <GridViewColumn Header="Compressed" Width="105" DisplayMemberBinding="{Binding CompressedDisplay}" />
                    <GridViewColumn Header="Modified" Width="145" DisplayMemberBinding="{Binding ModifiedDisplay}" />
                    <GridViewColumn Header="Type" Width="125" DisplayMemberBinding="{Binding TypeDisplay}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgSidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid>
                <TextBlock x:Name="StatusText"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ProgressBar x:Name="OperationProgress"
                             Width="180" Height="6"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Maximum="100"
                             Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
